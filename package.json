{
  "name": "esp32-agent-companion",
  "private": true,
  "license": "MIT",
  "description": "One-word commands for setting up and customizing the ESP32 Agent Companion.",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "setup": "node tools/companion.mjs setup",
    "settings": "node tools/companion.mjs settings",
    "status": "node tools/companion.mjs status",
    "speak": "node tools/companion.mjs speak",
    "wifi": "node tools/companion.mjs wifi",
    "pair": "node tools/companion.mjs pair",
    "character": "node tools/companion.mjs character",
    "connection": "node tools/companion.mjs connection",
    "agents": "node tools/companion.mjs agents",
    "badges": "node tools/companion.mjs badges",
    "desktop": "npm install --prefix desktop --no-audit --no-fund && npm --prefix desktop start",
    "website": "node website/scripts/build.mjs && node website/scripts/serve.mjs"
  }
}
