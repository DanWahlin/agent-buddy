{
  "name": "agent-companion-desktop-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "build:engine": "node engine/build.mjs",
    "build": "npm run build:engine && npm run build -w @agent-companion/desktop",
    "typecheck": "tsc -p apps/desktop/tsconfig.json",
    "test": "npm run typecheck && node --test engine/test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
