{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Click-through prototype",
  "version": "0.1.0",
  "identifier": "dev.agentcompanion.clickthrough",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Companion",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
